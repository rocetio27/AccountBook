<Page ux:Class="InputPage" >
	<JavaScript File="Modules/InputPage.js"/>
	<Panel ux:Name="FullWindo" Layer="Overlay" />
	<Grid Padding="5,0,5,0" RowCount="100" Color="{#ffbd00}">
		<DockPanel RowSpan="55">
			<Grid ux:Name="ScreenGrid" Padding="5,10,5,5" RowCount="57">
				<Panel RowSpan="12"/>
				<Panel RowSpan="44">
					<Rectangle CornerRadius="2" Color="{#fff}">
					<Grid RowCount="43">
						<Panel RowSpan="12"/> 
						<Text RowSpan="3" Alignment="Center" Value="{cashOrCardText}" Color="#333"/>
						<Text RowSpan="3" Alignment="Center" Value="현재 잔액" Color="#333"/>
						<Text RowSpan="7" FontSize="45" Alignment="Center" Value="{currentBalance}" Color="#333"/>
						<Text Font="Bold" RowSpan="2" FontSize="30" Alignment="Center" TextColor="{addingValueColor}" Value="{inputVars.pmType} {addingValue}"/>
						<Panel RowSpan="16"/>
					</Grid>
					</Rectangle>
				</Panel>
			</Grid>
			<WhileKeyboardVisible>
				<Change Target="ScreenGrid.Opacity" Value="0" Duration="0.3" />
			</WhileKeyboardVisible>
		</DockPanel>
		<DockPanel RowSpan="45">
			<Panel Padding="5,0,5,15">
				<Rectangle CornerRadius="3" Padding="3" Color="{#eee}">
				<Grid RowSpan="43" Alignment="Bottom" Height="100%" ux:Name="KeyboardGrid" RowCount="5" ColumnCount="5">
				
				<TextInput PlaceholderText="추가 될 내역의 이름을 입력해주세요." PlaceholderColor="#888" ux:Name="usageTextInput" Padding="1" ColumnSpan="5" Value="{inputVars.usage}" Height="100%" Width="100%" Font="Bold" TextColor="#333" TextAlignment="Center">
					<Rectangle Color="{#fff}" CornerRadius="2">
					<SolidColor ux:Name="wbRecCol" Color="{#fff}"/>
			    	<Stroke Width="2" Color="#eee" >
			    	</Stroke>
					</Rectangle>
				</TextInput>
				<wbButton Text="{payTypeText}" Clicked="{PayTypeChange}" ColumnSpan="3" />
				<Grid ColumnCount="8" ColumnSpan="2">
				<wbButton ux:Name="usage_button" ColumnSpan="8" Text="즐겨찾기">
					<Clicked>
					<Set ModalConfirm.IsEnabled="true"/>
					</Clicked>
				</wbButton>
				</Grid>
				
				<Each Items="{numSet}">
					<wbButton Text="{data()}" Clicked="{BalanceAdd}" />
				</Each>
				<wbButton Text="<" Clicked="{Backspace}"/>
				<pmButton ColumnSpan="2" Text="{pmTypeText}"/>
				<wbButton Text="입력" Clicked="{Submit}" ColumnSpan="2" />
				
				<WhileKeyboardVisible>
					<Move RelativeTo="Keyboard" Y="-1" />
				</WhileKeyboardVisible>
				</Grid>
				</Rectangle>
			</Panel>
		</DockPanel>
	</Grid>
	<ResourceObject Key="FullWindow" Value="FullWindo"/>
	<AlternateRoot ux:Name="ModalConfirm" IsEnabled="false" ParentNode="{Resource FullWindow}">
		<Panel Layer="Overlay" Color="1,1,1,0">
			<StackPanel Alignment="Center" Padding="10">
				<Rectangle CornerRadius="10" Layer="Background"  Color="#fff">
					<Stroke Width="2" Color="{Resource AccountBook.Col_type3}"/>
				</Rectangle>

				<ScrollView>
					<Rectangle CornerRadius="8" Color="{Resource AccountBook.Col_type3}">
						<Grid ColumnCount="8">
							<TextInput ux:Name="popup_input" TextColor="#000" TextAlignment="Center" Height="30" PlaceholderText="add your usage" Value="{usageListAddInput}" ColumnSpan="6"/>
							<wbButton Text="ADD" ColumnSpan="2" Clicked="{AddToTempUsageList}" >
							</wbButton>
						</Grid>
					</Rectangle>
				</ScrollView>
				
				<DockPanel>
					<ScrollView Height="150" Width="200">
						<StackPanel>
							<Each Items="{tempUsageList}" Offset="{offset}" Limit="{limit}">
								<Grid ColumnCount="10">
									<ScrollView AllowedScrollDirections="Horizontal" ColumnSpan="7">
										<wbButton_Left Clicked="{SelectUsage}" Text="{name}">
												<Clicked>
													<Set ModalConfirm.IsEnabled="false"/>
													<PlaySound File="Click.wav" />
												</Clicked>
										</wbButton_Left>
									</ScrollView>
									<wbButton Text="Delete" Clicked="{removeItem}" ColumnSpan="3" Margin="7"/>
									<LayoutAnimation>
		                            	<Move RelativeTo="LayoutChange" Y="1" Duration="0.4" Easing="ElasticIn" />
			                        </LayoutAnimation>

			                        <AddingAnimation>
			                            <Move RelativeTo="Size" X="1" Duration="0.3" Easing="CircularIn" />
			                        </AddingAnimation>

			                        <RemovingAnimation>
			                            <Move RelativeTo="Size" X="-1" Duration="0.4" Easing="CircularOut" />
			                        </RemovingAnimation>
								</Grid>
							</Each>
						</StackPanel>
					</ScrollView>
				</DockPanel>

				<Button ux:Name="ok_button">
					<Text Value="OK" Color="#000" Alignment="Center" TextAlignment="Center"/>
					<Rectangle CornerRadius="5">
						<Stroke Width="2" Color="{Resource AccountBook.Col_type3}"/>
					</Rectangle>
					<WhilePressed>
						<Change ok_button.Color="{Resource AccountBook.Col_type3}" Duration="0.05" DurationBack=".2" />
					</WhilePressed>
					<Clicked>
						<Set ModalConfirm.IsEnabled="false"/>
						<PlaySound File="Click.wav" />
					</Clicked>
				</Button>
			</StackPanel>
		</Panel>
	</AlternateRoot>
</Page>
